<Window x:Class="LocalRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalRecorder"
        Width="940"
        MinWidth="860"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="#3D5166"
        Foreground="White"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="MenuRow" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1C88F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#186FBF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SourceCombo" TargetType="ComboBox">
            <Setter Property="Width" Value="86"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource MenuRow}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Face" Background="#1C88F0" CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Grid.Column="0" Width="28" Height="22" HorizontalAlignment="Center">
                                                    <Grid Width="24" Height="20">
                                                        <Rectangle Width="22" Height="13" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                                        <Rectangle Width="5" Height="3" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                                        <Rectangle Width="12" Height="2" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                                    </Grid>
                                                </Viewbox>
                                                <Border Grid.Column="1" Background="#1876D4"/>
                                                <Path Grid.Column="2"
                                                      Data="M1,1 L5,5 L9,1"
                                                      Stroke="White"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="9"
                                                      Height="5"
                                                      Stretch="Fill"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Face" Property="Background" Value="#3B9AF5"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Face" Property="Background" Value="#1576D6"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Face" Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="None"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="280"
                                        Margin="0,4,0,0"
                                        Background="#2C3E50"
                                        BorderBrush="#1B2836"
                                        BorderThickness="1"
                                        Padding="4">
                                    <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KindCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1C88F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource MenuRow}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Face" Background="#1C88F0" CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="10,0,4,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      ContentSource="SelectionBoxItem"
                                                      TextElement.Foreground="White"
                                                      IsHitTestVisible="False"/>
                                    <Path Grid.Column="1"
                                          Data="M1,1 L5,5 L9,1"
                                          Stroke="White"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="10"
                                          Height="6"
                                          Stretch="Fill"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0"
                                        Background="#2C3E50"
                                        BorderBrush="#1B2836"
                                        BorderThickness="1"
                                        Padding="4">
                                    <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#3B9AF5"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#1576D6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1A2633"/>
            <Setter Property="BorderBrush" Value="#243444"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource MenuRow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Shell"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="10,0,0,0"
                                                      VerticalAlignment="Center"
                                                      ContentSource="SelectionBoxItem"
                                                      IsHitTestVisible="False"/>
                                    <Path Grid.Column="1"
                                          Data="M1,1 L5,5 L9,1"
                                          Stroke="#D5DEE8"
                                          StrokeThickness="1.4"
                                          Width="9"
                                          Height="5"
                                          Stretch="Fill"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0"
                                        Background="#2C3E50"
                                        BorderBrush="#1B2836"
                                        BorderThickness="1"
                                        Padding="4">
                                    <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#2C4156"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#1A2836"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#2C4156"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#3E5368"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1B2836" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="68"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#2C3E50" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/app.png"
                               Width="16"
                               Height="16"
                               Margin="10,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="LocalRecorder"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource CaptionButton}"
                                ToolTip="Küçült"
                                Click="MinimizeButton_Click">
                            <Border Width="11" Height="1" Background="White" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource CloseCaptionButton}"
                                ToolTip="Kapat"
                                Click="CloseButton_Click">
                            <Path Data="M0,0 L10,10 M10,0 L0,10"
                                  Stroke="White"
                                  StrokeThickness="1.2"
                                  Width="10"
                                  Height="10"
                                  Stretch="Fill"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="10,8,10,0"
                    Background="#1EAE4A"
                    BorderBrush="Black"
                    BorderThickness="2">
                <ComboBox x:Name="RecordingKindComboBox"
                          Style="{StaticResource KindCombo}"
                          Width="196"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="0,10,12,0"
                          DisplayMemberPath="Name"
                          ToolTip="Kayıt türü"/>
            </Border>

            <Grid Grid.Row="2" Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="CaptureModeComboBox"
                          Grid.Column="0"
                          Style="{StaticResource SourceCombo}"
                          VerticalAlignment="Center"
                          DisplayMemberPath="Name"
                          ToolTip="Kayıt kaynağı"
                          SelectionChanged="CaptureModeComboBox_SelectionChanged"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="TimerText"
                               Text="00:00:00"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock x:Name="SizeText"
                               Text="0.0 KB / --"
                               FontSize="11"
                               Foreground="#D5DEE8"
                               Margin="1,-1,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="FpsButton"
                            Width="46"
                            Height="42"
                            Margin="4,0"
                            Background="#1A2633"
                            ToolTip="Kare hızı"
                            Click="FpsButton_Click"
                            Style="{StaticResource IconButton}">
                        <StackPanel>
                            <TextBlock x:Name="FpsValueText"
                                       Text="30"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="FPS"
                                       FontSize="9"
                                       Foreground="#C9D4E0"
                                       HorizontalAlignment="Center"
                                       Margin="0,-1,0,0"/>
                        </StackPanel>
                    </Button>

                    <ToggleButton x:Name="SpeakerToggle"
                                  Style="{StaticResource IconToggle}"
                                  Margin="4,0"
                                  IsChecked="True"
                                  ToolTip="Bilgisayar sesi açık"
                                  Click="SpeakerToggle_Click">
                        <Viewbox Width="18" Height="16">
                            <Canvas Width="20" Height="16">
                                <Path Fill="White" Data="M1,5 H5 L10,1 V15 L5,11 H1 Z"/>
                                <Path Stroke="White"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      Fill="Transparent"
                                      Data="M13,5.2 C14.8,6.4 14.8,9.6 13,10.8"/>
                                <Path Stroke="White"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      Fill="Transparent"
                                      Data="M15,3 C18.4,5.2 18.4,10.8 15,13"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>

                    <ToggleButton x:Name="MicToggle"
                                  Style="{StaticResource IconToggle}"
                                  Margin="4,0"
                                  IsChecked="False"
                                  ToolTip="Mikrofon kapalı"
                                  Click="MicToggle_Click">
                        <Viewbox Width="16" Height="20">
                            <Canvas Width="16" Height="22">
                                <Rectangle Canvas.Left="4" Canvas.Top="1" Width="8" Height="12" RadiusX="4" RadiusY="4"
                                           Stroke="White" StrokeThickness="1.6" Fill="Transparent"/>
                                <Path Stroke="White" StrokeThickness="1.6" Fill="Transparent"
                                      Data="M2,10 C2,15 4.5,17 8,17 C11.5,17 14,15 14,10"/>
                                <Path Stroke="White" StrokeThickness="1.6" Data="M8,17 L8,21"/>
                                <Path Stroke="White" StrokeThickness="1.6" Data="M5,21 L11,21"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>

                    <Button x:Name="PauseButton"
                            Style="{StaticResource IconButton}"
                            Margin="6,0,8,0"
                            IsEnabled="False"
                            ToolTip="Duraklat"
                            Click="PauseButton_Click">
                        <Grid Width="16" Height="16">
                            <StackPanel x:Name="PauseBars" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="4" Height="16" Background="White" Margin="0,0,3,0"/>
                                <Border Width="4" Height="16" Background="White"/>
                            </StackPanel>
                            <Path x:Name="ResumeIcon"
                                  Visibility="Collapsed"
                                  Fill="White"
                                  Data="M0,0 L0,14 L12,7 Z"
                                  Stretch="Uniform"
                                  Width="13"
                                  Height="14"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="RecordButton"
                            Width="52"
                            Height="52"
                            Margin="0,0,8,0"
                            Background="#F13232"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            ToolTip="Kaydı başlat"
                            Click="RecordButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF4A4A"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#D42626"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Disc" Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Border x:Name="StopGlyph"
                                Width="16"
                                Height="16"
                                Background="White"
                                CornerRadius="1"
                                Visibility="Collapsed"/>
                    </Button>

                    <Button x:Name="SelectAreaButton"
                            Style="{StaticResource IconButton}"
                            Margin="0,0,4,0"
                            ToolTip="Alanı belirle"
                            Click="SelectAreaButton_Click">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="18" Height="18">
                                <Rectangle Canvas.Left="1" Canvas.Top="5" Width="11" Height="11"
                                           Stroke="White" StrokeThickness="1.6" Fill="Transparent"/>
                                <Rectangle Canvas.Left="8" Canvas.Top="1" Width="8" Height="8"
                                           Stroke="White" StrokeThickness="1.6" Fill="#3D5166"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Background="#354859" BorderBrush="#2A3C4E" BorderThickness="0,1,0,0">
                <StackPanel>
                    <Grid Height="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="12" Height="12" Margin="10,0,8,0"
                                BorderBrush="#D5DEE8" BorderThickness="1" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SourceDetailText"
                                   Grid.Column="1"
                                   Text="Ekran seçin"
                                   Foreground="#E4EBF3"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,10,0">
                            <TextBlock x:Name="FpsStatusText"
                                       Text="30 FPS"
                                       Foreground="#D5DEE8"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="  ·  " Foreground="#8EA0B3" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText"
                                       Text="Hazır"
                                       Foreground="#D5DEE8"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="WindowPickerPanel" Visibility="Collapsed" Margin="10,0,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="WindowComboBox"
                                  Style="{StaticResource BarCombo}"
                                  DisplayMemberPath="Title"
                                  ToolTip="Kaydedilecek pencere"
                                  SelectionChanged="WindowComboBox_SelectionChanged"/>
                        <Button x:Name="RefreshWindowsButton"
                                Grid.Column="1"
                                Content="Yenile"
                                Height="34"
                                Margin="8,0,0,0"
                                Padding="12,0"
                                Background="#1A2633"
                                Foreground="White"
                                BorderBrush="#243444"
                                BorderThickness="1"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                Click="RefreshWindowsButton_Click"/>
                    </Grid>

                    <TextBlock x:Name="SelectedAreaText"
                               Visibility="Collapsed"
                               Margin="12,0,12,8"
                               Foreground="#D5DEE8"
                               FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
